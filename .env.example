# Copy thành .env rồi điền. File .env KHÔNG được commit.
# Để trống 2 dòng VITE_ bên dưới = chạy chế độ session data (không cần đăng nhập, mất dữ liệu khi đóng tab).

# Supabase Dashboard → Project Settings → API Keys
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Publishable key (sb_publishable_...) — an toàn để nằm trong frontend, được bảo vệ bởi RLS + đăng nhập
VITE_SUPABASE_PUBLISHABLE_KEY=

# ---- CHỈ dùng cho `npm run seed` chạy trên máy bạn ----
# Secret key (sb_secret_...) bỏ qua RLS. KHÔNG thêm tiền tố VITE_ (Vite sẽ nhúng vào bundle và lộ ra trình duyệt).
SUPABASE_SECRET_KEY=
# (tuỳ chọn) tạo sẵn 1 tài khoản đăng nhập
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
